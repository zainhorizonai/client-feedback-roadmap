{
  "name": "feedback-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"npm:server:watch\"",
    "build": "tsc -b && tsc -p server && vite build",
    "server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "server:watch": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import tsx server/index.ts",
    "seed": "node --env-file-if-exists=.env --import tsx server/seed.ts",
    "test": "node --import tsx --test server/test/api.test.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@hono/node-server": "^2.1.8",
    "@neondatabase/serverless": "^1.2.1",
    "@vercel/blob": "^2.9.0",
    "fix-webm-duration": "^1.0.6",
    "hono": "^4.13.18",
    "lucide-react": "^1.73.0",
    "nodemailer": "^10.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
