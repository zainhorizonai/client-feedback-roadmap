# ---- Local development ----
# Leave DATABASE_URL and BLOB_READ_WRITE_TOKEN empty locally: an embedded Postgres (in ./data/pgdata)
# and local disk storage are used automatically.

APP_URL=http://localhost:5173
PORT=8787

# Comma-separated emails that get admin access (created the first time they sign in).
ADMIN_EMAILS=you@horizondigital.cloud

# Local only: where the embedded database and videos live.
DATA_DIR=./data
MAX_VIDEO_MB=500

# "console" prints emails in the terminal (dev).
# "smtp" sends through any mailbox, e.g. Gmail with an app password (no domain needed).
# "resend" sends through Resend (needs a verified domain to email anyone but yourself).
EMAIL_PROVIDER=console
EMAIL_FROM=Feedback Portal <you@gmail.com>

# smtp (defaults are for Gmail)
SMTP_USER=you@gmail.com
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# resend
RESEND_API_KEY=

# ---- Vercel (set in Project Settings > Environment Variables) ----
# DATABASE_URL           added automatically by the Neon integration
# BLOB_READ_WRITE_TOKEN  added automatically when you connect a Blob store (choose PRIVATE access)
# CRON_SECRET            any long random string; enables the nightly cleanup job
# APP_URL                optional. Defaults to the deployment URL; set it when you add a custom domain.
