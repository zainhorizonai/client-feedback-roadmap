# Public URL of the app. Used in email links and for cross-origin checks.
APP_URL=http://localhost:5173
PORT=8787

# Comma-separated emails that get admin access (created automatically on start).
ADMIN_EMAILS=you@horizondigital.cloud

# Where the database and uploaded videos live. Back this folder up.
DATA_DIR=./data
MAX_VIDEO_MB=500

# Email: "console" only logs emails to the terminal (dev). "resend" sends real email.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Feedback Portal <portal@yourdomain.com>
